# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Directory for storing temporary user session files (optional, defaults to data/sessions)
SESSION_DIR=data/sessions

# Directory for generated DOCX/PDF files (kept by retention policy)
GENERATED_DIR=data/generated

# Generated files and stale drafts older than this are removed automatically
GENERATED_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# Large phone photos are downscaled before processing to avoid memory spikes
MAX_UPLOAD_IMAGE_SIDE_PX=2400

# DOCX export size control. Product photos are embedded as print-quality JPEGs
# instead of huge phone-resolution PNGs.
MAX_EMBEDDED_PHOTO_DPI=300
PHOTO_JPEG_QUALITY=82
TELEGRAM_SAFE_DOCUMENT_SIZE_MB=45
MAX_PRODUCTS_PER_DOCX_PART=72

# Runtime mode: polling or webhook
BOT_RUN_MODE=polling

# Webhook settings (required only when BOT_RUN_MODE=webhook)
WEBHOOK_BASE_URL=https://your-domain.example
WEBHOOK_PATH=/tg/replace_with_random_path
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=8091
WEBHOOK_SECRET_TOKEN=replace_with_random_secret
